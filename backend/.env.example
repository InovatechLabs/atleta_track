# ============================================================
# AtletaTrack — Variáveis de ambiente
# Copie para .env e preencha os valores reais
# ============================================================

# Banco de dados
DATABASE_URL=postgresql://atletatrack:atletatrack@db:5432/atletatrack

# Cache
REDIS_URL=redis://redis:6379/0

# Segurança (RP04) — gere com: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS (RP02)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=atletatrack-models

# ML
ANOMALY_THRESHOLD=-0.2
KMEANS_CLUSTERS=4

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://atletatrack.app"]

# Frontend
VITE_API_URL=http://localhost:8000
